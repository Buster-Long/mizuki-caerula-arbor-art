[{"id":"mizuki-record-1","name":"The Hanging Grave","slug":"the-hanging-grave","description":"悬高之葬：你正站在一座悬崖墓园内。这里正在举行送别逝者的仪式。海民们将焚烧遗体，任由海风带走骨灰，棺木则原地竖起，作为寄托哀思的墓碑。","clientName":"Mizuki / Observation","completionDate":"2026-10-24T00:00:00.000Z","uiColor":"3a7fa8","tags":"Deep, Shore, Light","priority":1,"projectURL":"https://github.com/Buster-Long/mizuki-caerula-arbor-art","projectLogo":{"url":"/assets/daily/wordmark.png","width":400,"height":200},"video":{"url":"/assets/daily/study-the-hanging-grave.jpg","thumbnail":"/assets/daily/cover-cg03.jpg"}},{"id":"mizuki-record-2","name":"Ignorance Is Bliss","slug":"ignorance-is-bliss","description":"无知是福：你在海洋深处的溶洞中发现了一座科研设施，这里的大部分仪器都已损坏，完全无法分辨用途，只有个终端看上去还能启动。","clientName":"Mizuki / Observation","completionDate":"2026-10-24T00:00:00.000Z","uiColor":"4fe3d4","tags":"We Many, Trace, Deep","priority":2,"projectURL":"https://github.com/Buster-Long/mizuki-caerula-arbor-art","projectLogo":{"url":"/assets/daily/wordmark.png","width":400,"height":200},"video":{"url":"/assets/daily/study-ignorance-is-bliss.jpg","thumbnail":"/assets/daily/cover-cg06.jpg"}},{"id":"mizuki-record-3","name":"A Single Spark","slug":"a-single-spark","description":"点滴星火：噬尘已经覆盖了整座城市，文明产物都将被有序消解，化作海嗣生育后代与进化的养料。你在即将分解的废墟间艰难前行，寻找还能使用的物资。无意之间，你见到一块噬尘下正有什么东西在发出光亮。","clientName":"Mizuki / Observation","completionDate":"2026-10-24T00:00:00.000Z","uiColor":"f6e8cb","tags":"Light, Fate, Human","priority":3,"projectURL":"https://github.com/Buster-Long/mizuki-caerula-arbor-art","projectLogo":{"url":"/assets/daily/wordmark.png","width":400,"height":200},"video":{"url":"/assets/daily/study-a-single-spark.jpg","thumbnail":"/assets/daily/cover-cg07.jpg"}},{"id":"mizuki-record-4","name":"The Beginning","slug":"the-beginning","description":"开端：世界正在发生剧变，消息终端不断鸣响，坏消息接踵而至：恐鱼潮向着陆地行进，惩戒军舰队覆灭，深海教徒攻击伊比利亚颂圣棱堡。","clientName":"Mizuki / Observation","completionDate":"2026-10-24T00:00:00.000Z","uiColor":"9be8e0","tags":"Human, Trace, Deep","priority":4,"projectURL":"https://github.com/Buster-Long/mizuki-caerula-arbor-art","projectLogo":{"url":"/assets/daily/wordmark.png","width":400,"height":200},"video":{"url":"/assets/daily/study-the-beginning.jpg","thumbnail":"/assets/daily/cover-cg26.jpg"}},{"id":"mizuki-record-5","name":"Heart of Caerula","slug":"heart-of-caerula","description":"深蓝之心：地图标注的地点上存在着一具巨大的尸骸。大群恐鱼聚集其间，吞食着不断生长的残躯。水月带领着你避开恐鱼，向着尸骸内部前进。","clientName":"Mizuki / Record","completionDate":"2026-10-24T00:00:00.000Z","uiColor":"4fe3d4","tags":"We Many, Trace, Deep","priority":5,"projectURL":"https://github.com/Buster-Long/mizuki-caerula-arbor-art","projectLogo":{"url":"/assets/daily/wordmark.png","width":400,"height":200},"video":{"url":"/assets/daily/study-heart-of-caerula.jpg","thumbnail":"/assets/daily/cover-cg27.jpg"}},{"id":"mizuki-record-6","name":"Glimpse","slug":"glimpse","description":"瞥视：碑林的碎片被溟痕同化，沉落在消亡巨物旁，碑文不断变化，昭示着万千可能性：你与相识的女性结为伴侣，抑或成为她的死敌；你引领人类对抗海嗣，或身为海嗣带领族群。","clientName":"Mizuki / Record","completionDate":"2026-10-24T00:00:00.000Z","uiColor":"3a2a63","tags":"We Many, Firstborn, Root","priority":6,"projectURL":"https://github.com/Buster-Long/mizuki-caerula-arbor-art","projectLogo":{"url":"/assets/daily/wordmark.png","width":400,"height":200},"video":{"url":"/assets/daily/study-glimpse.jpg","thumbnail":"/assets/daily/cover-cg29.jpg"}},{"id":"mizuki-record-7","name":"Kindling Wood","slug":"kindling-wood","description":"引火之木：你在收集引火的木头时发现了一个奇怪的林子，树木片叶不生，树皮薄而通透，光滑得像是皮肤，轻轻用刀割开便流出带有异香的树脂。","clientName":"Mizuki / Record","completionDate":"2026-10-24T00:00:00.000Z","uiColor":"3a7fa8","tags":"Deep, Grow, We Many","priority":7,"projectURL":"https://github.com/Buster-Long/mizuki-caerula-arbor-art","projectLogo":{"url":"/assets/daily/wordmark.png","width":400,"height":200},"video":{"url":"/assets/daily/study-kindling-wood.jpg","thumbnail":"/assets/daily/cover-cg35.jpg"}},{"id":"mizuki-record-8","name":"The Lighthouse Keeper","slug":"the-lighthouse-keeper","description":"灯塔看守人：老人在沙滩上画了一座灯塔，涌上来的潮水迅速抹去了所有痕迹。“大海这次真正吞噬了它们。”他自言自语。","clientName":"Mizuki / Record","completionDate":"2026-10-24T00:00:00.000Z","uiColor":"d6edf2","tags":"Human, Appetite, Light","priority":8,"projectURL":"https://github.com/Buster-Long/mizuki-caerula-arbor-art","projectLogo":{"url":"/assets/daily/wordmark.png","width":400,"height":200},"video":{"url":"/assets/daily/study-the-lighthouse-keeper.jpg","thumbnail":"/assets/daily/cover-cg36.jpg"}},{"id":"mizuki-record-9","name":"Precious Days","slug":"precious-days","description":"平凡即是喜乐：出发时预想的目标在终点达成，介于海嗣与人类之间的生物准备在饱餐一顿后迎来明天。日常是命运赐予生灵最大的善意，平凡，即是喜乐。","clientName":"Mizuki / Record","completionDate":"2026-10-24T00:00:00.000Z","uiColor":"f6e8cb","tags":"Deep, Ending, Light","priority":9,"projectURL":"https://github.com/Buster-Long/mizuki-caerula-arbor-art","projectLogo":{"url":"/assets/daily/wordmark.png","width":400,"height":200},"video":{"url":"/assets/daily/study-precious-days.jpg","thumbnail":"/assets/daily/cover-cg48.jpg"}},{"id":"mizuki-record-10","name":"Age of the Silence","slug":"age-of-the-silence","description":"静谧时代：无声巨浪拔地而起，骑士的怒吼消失在静谧之中，毁灭伊比利亚的灾难重新降临，而它再也不会褪去。","clientName":"Mizuki / Record","completionDate":"2026-10-24T00:00:00.000Z","uiColor":"3a7fa8","tags":"Deep, Ending, We Many","priority":10,"projectURL":"https://github.com/Buster-Long/mizuki-caerula-arbor-art","projectLogo":{"url":"/assets/daily/wordmark.png","width":400,"height":200},"video":{"url":"/assets/daily/study-age-of-the-silence.jpg","thumbnail":"/assets/daily/cover-cg49.jpg"}},{"id":"mizuki-record-11","name":"Price of Peace","slug":"price-of-peace","description":"息潮的代价：“初生”的争端告一段落，为人的祂胜过了非人的祂。","clientName":"Mizuki / Record","completionDate":"2026-10-24T00:00:00.000Z","uiColor":"9be8e0","tags":"Deep, Ending, Human","priority":11,"projectURL":"https://github.com/Buster-Long/mizuki-caerula-arbor-art","projectLogo":{"url":"/assets/daily/wordmark.png","width":400,"height":200},"video":{"url":"/assets/daily/study-price-of-peace.jpg","thumbnail":"/assets/daily/cover-cg50.jpg"}},{"id":"mizuki-record-12","name":"Price of Peace II","slug":"price-of-peace-ii","description":"息潮的代价 · 其二：静谧褪去，海潮平息，名为水月的生灵再也无法返回大地。","clientName":"Mizuki / Record","completionDate":"2026-10-24T00:00:00.000Z","uiColor":"d6edf2","tags":"Deep, Ending, Firstborn","priority":12,"projectURL":"https://github.com/Buster-Long/mizuki-caerula-arbor-art","projectLogo":{"url":"/assets/daily/wordmark.png","width":400,"height":200},"video":{"url":"/assets/daily/study-price-of-peace-ii.jpg","thumbnail":"/assets/daily/cover-cg51.jpg"}},{"id":"mizuki-record-13","name":"Stella Caerula","slug":"stella-caerula","description":"如星空般深蓝：进化的后裔从泰拉潮水中升起，破开云霄，去往无际星海。此刻，世间再无苦难，只余下新生的喜悦。","clientName":"Mizuki / Record","completionDate":"2026-10-24T00:00:00.000Z","uiColor":"4fe3d4","tags":"Deep, Ending, Firstborn","priority":13,"projectURL":"https://github.com/Buster-Long/mizuki-caerula-arbor-art","projectLogo":{"url":"/assets/daily/wordmark.png","width":400,"height":200},"video":{"url":"/assets/daily/study-stella-caerula.jpg","thumbnail":"/assets/daily/cover-cg52.jpg"}},{"id":"mizuki-record-14","name":"The Caerula Rite","slug":"the-caerula-rite","description":"深蓝仪式：你目送水月进入了通向实验中枢底层的传输舱，自己则前往主控台查询水月即将面对的实验内容。这是一个漫长的全自动化改造流程，百年，还是千年？","clientName":"Mizuki / Record","completionDate":"2026-10-24T00:00:00.000Z","uiColor":"3a2a63","tags":"We Many, Firstborn, Grow","priority":14,"projectURL":"https://github.com/Buster-Long/mizuki-caerula-arbor-art","projectLogo":{"url":"/assets/daily/wordmark.png","width":400,"height":200},"video":{"url":"/assets/daily/study-the-caerula-rite.jpg","thumbnail":"/assets/daily/cover-cg53.jpg"}}]